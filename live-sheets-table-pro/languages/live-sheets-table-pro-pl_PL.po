msgstr "Fioletowy"

#: includes/views/settings-page.php:85
msgid "Read access only — this can never change anything in Google"
msgstr "Tylko odczyt — to nigdy niczego nie zmieni w Google"

#: includes/views/settings-page.php:176
msgid "Read through the connected account"
msgstr "Odczyt przez połączone konto"

#: includes/class-lstabp-rules.php:109
msgid "Red"
msgstr "Czerwony"

#. translators: 1: page number, 2: number of pages, 3: total rows.
#: includes/class-lstabp-picker.php:80
msgid "Rows — page %1$s of %2$s (%3$s in all)"
msgstr "Wiersze — strona %1$s z %2$s (razem %3$s)"

#: includes/views/rules-card.php:73
msgid "Rules are read from the top down. If two of them colour the same place, the lower one wins, so put the general rule first."
msgstr "Reguły są czytane od góry. Jeśli dwie kolorują to samo miejsce, wygrywa niższa, więc regułę ogólną umieść wyżej."

#: includes/class-lstabp-rules.php:135
msgid "S"
msgstr "S"

#: includes/views/settings-page.php:185
msgid "Save"
msgstr "Zapisz"

#: includes/views/settings-page.php:117

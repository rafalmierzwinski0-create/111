msgstr "Nie ukryto jeszcze żadnego wiersza."

#: includes/views/settings-page.php:152
msgid "No sheet sources yet."
msgstr "Nie ma jeszcze żadnych źródeł arkuszy."

#: includes/views/settings-page.php:103
msgid "Not connected yet"
msgstr "Jeszcze niepołączone"

#: includes/class-lstabp-facets.php:470
msgid "Nothing here matches that."
msgstr "Nic tu nie pasuje."

#. translators: %s: the headings a rule names, comma separated.
#: includes/views/rules-card.php:102
msgid "Nothing is coloured by %s until the rule points at a heading that exists. The rule is kept until you change it."
msgstr "Nic nie jest kolorowane przez %s, dopóki reguła nie wskaże istniejącego nagłówka. Reguła pozostaje zapisana."

#. translators: %s: number of rules.
#: includes/views/rules-card.php:92
msgid "One rule names a column your sheet no longer has."
msgid_plural "%s rules name columns your sheet no longer has."
msgstr[0] "Jedna reguła wskazuje kolumnę, której nie ma już w arkuszu."
msgstr[1] "%s reguły wskazują kolumny, których nie ma już w arkuszu."
msgstr[2] "%s reguł wskazuje kolumny, których nie ma już w arkuszu."

#: includes/views/settings-page.php:112
msgid "Only read access to spreadsheets is requested; this connection cannot change or delete anything in your Google account. Disconnecting takes effect immediately."
msgstr "Wymagany jest wyłącznie dostęp do odczytu arkuszy; to połączenie nie może niczego zmienić ani usunąć na Twoim koncie Google. Rozłączenie działa natychmiast."

#: includes/views/settings-page.php:37
msgid "Open Google Cloud Console and create a project."
msgstr "Otwórz Google Cloud Console i utwórz projekt."

#: includes/class-lstabp-rules.php:110
msgid "Orange"
msgstr "Pomarańczowy"

#: includes/views/rule-line.php:156

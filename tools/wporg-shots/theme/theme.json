{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 3,
	"customTemplates": [
		{ "name": "showcase-fernhouse", "title": "Fernhouse", "postTypes": [ "page" ] },
		{ "name": "showcase-walks", "title": "Old Town Walks", "postTypes": [ "page" ] },
		{ "name": "showcase-venue", "title": "Northlight", "postTypes": [ "page" ] }
	],
	"settings": {
		"layout": { "contentSize": "720px", "wideSize": "1240px" },
		"typography": {
			"fontFamilies": [
				{ "name": "Manrope", "slug": "manrope", "fontFamily": "Manrope, sans-serif" },
				{ "name": "Literata", "slug": "literata", "fontFamily": "Literata, Georgia, serif" },
				{ "name": "Platypi", "slug": "platypi", "fontFamily": "Platypi, Georgia, serif" }
			]
		}
	},
	"styles": {
		"color": { "background": "#ffffff", "text": "#24231f" },
		"typography": { "fontFamily": "var(--wp--preset--font-family--manrope)", "fontSize": "17px", "lineHeight": "1.6" },
		"elements": {
			"heading": { "typography": { "fontFamily": "var(--wp--preset--font-family--literata)", "fontWeight": "500", "letterSpacing": "-0.015em", "lineHeight": "1.1" } },
			"button": { "border": { "radius": "999px" }, "typography": { "fontWeight": "600", "fontSize": "16px" } }
		}
	}
}

#: includes/class-lstab-fetcher.php:250
msgid "Google could not find this spreadsheet (HTTP 404). Check that the link is correct and the file has not been deleted."
msgstr "Google nie znalazł tego arkusza (HTTP 404). Sprawdź, czy link jest poprawny i czy plik nie został usunięty."

#: includes/class-lstab-fetcher.php:252
msgid "Google is rate limiting requests (HTTP 429). The next scheduled sync will try again."
msgstr "Google ogranicza liczbę żądań (HTTP 429). Kolejna zaplanowana synchronizacja spróbuje ponownie."

#: includes/class-lstab-fetcher.php:248
msgid "Google refused access to this sheet (HTTP 403). Open the sheet, choose Share, and set access to \"Anyone with the link – Viewer\"."
msgstr "Google odmówił dostępu do tego arkusza (HTTP 403). Otwórz arkusz, wybierz Udostępnij i ustaw dostęp na „Każdy, kto ma link – Przeglądający”."

#. translators: %d: HTTP status code.
#: includes/class-lstab-fetcher.php:256

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "clipper/stream_render_log.schema.json",
  "title": "stream_render_log.json (stream mode)",
  "type": "object",
  "required": ["schema_version", "kind", "fingerprint", "layout", "clips"],
  "properties": {
    "schema_version": {"type": "string", "pattern": "^1\\.[0-9]+$"},
    "kind": {"const": "stream_render_log"},
    "fingerprint": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "clips": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["rank", "output", "start", "end"]}}
  }
}

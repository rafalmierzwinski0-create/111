{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "clipper/stream_moments.schema.json",
  "title": "stream_moments.json (stream mode)",
  "type": "object",
  "required": [
    "schema_version",
    "kind",
    "fingerprint",
    "source",
    "clips"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "pattern": "^1\\.[0-9]+$"
    },
    "kind": {
      "const": "stream_moments"
    },
    "fingerprint": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "source": {
      "type": "object",
      "required": [
        "path",
        "duration"
      ]
    },
    "clips": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "rank",
          "peak",
          "start",
          "end",
          "duration",
          "score",
          "reasons"
        ],
        "properties": {
          "start": {
            "type": "number",
            "minimum": 0
          },
          "end": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "reasons": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}
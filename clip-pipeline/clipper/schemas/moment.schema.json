{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "clipper/moment.schema.json",
  "title": "moment.json (IMPLEMENTATION_PLAN.md 5.5)",
  "type": "object",
  "required": ["schema_version", "kind", "fingerprint", "source", "inputs", "scorer", "constraints", "selected", "clip", "candidates", "rejected"],
  "properties": {
    "schema_version": {"type": "string", "pattern": "^1\\.[0-9]+$"},
    "kind": {"const": "moment"},
    "fingerprint": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "source": {"$ref": "detections.schema.json#/$defs/source"},
    "inputs": {
      "type": "object",
      "required": ["transcript"],
      "properties": {"transcript": {"type": "object", "required": ["path", "sha256"],
                                    "properties": {"path": {"type": "string"}, "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}}}
    },
    "scorer": {"type": "object", "required": ["name", "version", "params"],
               "properties": {"name": {"enum": ["heuristic", "llm"]}, "version": {"type": "string"}, "params": {"type": "object"},
                              "notes": {"type": "array", "items": {"type": "string"}}}},
    "constraints": {"type": "object", "required": ["target_s", "min_s", "max_s", "sentence_snapping"],
                    "properties": {"sentence_snapping": {"const": "hard"}}},
    "transcript_stats": {"type": "object"},
    "selected": {"$ref": "#/$defs/candidate"},
    "clip": {"type": "object", "required": ["start", "end"],
             "properties": {"start": {"type": "number", "minimum": 0}, "end": {"type": "number", "exclusiveMinimum": 0}}},
    "candidates": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/candidate"}},
    "candidates_scored": {"type": "integer", "minimum": 0},
    "rejected": {"type": "object", "additionalProperties": {"type": "integer", "minimum": 0}}
  },
  "$defs": {
    "candidate": {
      "type": "object",
      "required": ["start", "end", "duration", "first_sentence", "last_sentence", "score", "features", "reasons", "text"],
      "properties": {
        "start": {"type": "number", "minimum": 0},
        "end": {"type": "number", "exclusiveMinimum": 0},
        "duration": {"type": "number", "exclusiveMinimum": 0},
        "first_sentence": {"type": "integer", "minimum": 0},
        "last_sentence": {"type": "integer", "minimum": 0},
        "score": {"type": "number"},
        "features": {"type": "object"},
        "reasons": {"type": "array", "items": {"type": "string"}},
        "text": {"type": "string"}
      }
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "clipper/transcript.schema.json",
  "title": "transcript (IMPLEMENTATION_PLAN.md 5.4)",
  "type": "object",
  "required": ["schema_version", "kind", "segments"],
  "properties": {
    "schema_version": {"type": "string", "pattern": "^1\\.[0-9]+$"},
    "kind": {"const": "transcript"},
    "language": {"type": "string"},
    "segments": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["start", "end", "text"],
        "properties": {
          "start": {"type": "number", "minimum": 0},
          "end": {"type": "number", "minimum": 0},
          "text": {"type": "string"},
          "speaker": {"type": "string"},
          "words": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["start", "end", "word"],
              "properties": {"start": {"type": "number", "minimum": 0}, "end": {"type": "number", "minimum": 0},
                             "word": {"type": "string"}, "speaker": {"type": "string"}}
            }
          }
        }
      }
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "clipper/stream_plan.schema.json",
  "title": "stream_plan.json (stream mode)",
  "type": "object",
  "required": ["schema_version", "kind", "fingerprint", "source", "layout", "regions", "output", "clips"],
  "properties": {
    "schema_version": {"type": "string", "pattern": "^1\\.[0-9]+$"},
    "kind": {"const": "stream_plan"},
    "fingerprint": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "source": {"$ref": "detections.schema.json#/$defs/source"}, "layout": {"enum": ["fit", "stacked", "gameplay", "follow"]}, "regions": {"type": "array", "items": {"type": "object", "required": ["name", "src", "dst"], "properties": {"src": {"type": "array", "minItems": 4, "maxItems": 4}, "dst": {"type": "array", "minItems": 4, "maxItems": 4}}}}, "clips": {"type": "array", "minItems": 1}
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "clipper/render_log.schema.json",
  "title": "render_log.json / overlay_log.json: rectangles actually applied or drawn per frame",
  "type": "object",
  "required": ["schema_version", "kind", "fingerprint", "inputs", "output", "frames"],
  "properties": {
    "schema_version": {"type": "string", "pattern": "^1\\.[0-9]+$"},
    "kind": {"enum": ["render_log", "overlay_log"]},
    "fingerprint": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "inputs": {"type": "object"},
    "output": {"type": "object", "required": ["path", "frames"]},
    "frames": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["t", "x", "y", "w", "h"],
        "properties": {"t": {"type": "number"}, "source_t": {"type": "number"}, "x": {"type": "number"}, "y": {"type": "number"},
                       "w": {"type": "number"}, "h": {"type": "number"}}
      }
    }
  }
}
